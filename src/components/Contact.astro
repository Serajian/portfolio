---
import { site } from '../data/site';
import Icon from './Icon.astro';
import SectionHead from './SectionHead.astro';

const { contact, nav } = site;
const hue = nav.find((n) => n.id === 'contact')?.hue ?? 96;

const isExternal = (href: string) => href.startsWith('http');
---

<section class="sec" id="contact" data-hue={hue}>
  <SectionHead overline={contact.overline} lead={contact.heading.lead} dim={contact.heading.dim} />

  <p class="contact-lead rv">{contact.lead}</p>

  <div class="cinfo rv">
    {
      contact.links.map((link) => (
        <a
          href={link.href}
          target={isExternal(link.href) ? '_blank' : undefined}
          rel={isExternal(link.href) ? 'noopener noreferrer' : undefined}
        >
          <Icon name={link.icon} size={17} />
          <k>{link.label}</k>
          <span class="val">{link.value}</span>
          {link.href !== '#' && <em>↗</em>}
        </a>
      ))
    }
  </div>
</section>
