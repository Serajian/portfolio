---
type Kind = 'plain' | 'comment' | 'keyword' | 'fn' | 'string' | 'number';

interface Props {
  filename: string;
  lines: readonly (readonly { readonly t: string; readonly kind: Kind }[])[];
  class?: string;
}

const { filename, lines, class: className = '' } = Astro.props;

const CLASS_FOR: Record<Kind, string> = {
  plain: '',
  comment: 'c',
  keyword: 'k',
  fn: 'f',
  string: 's',
  number: 'n',
};

const escape = (s: string) =>
  s.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');

/* built as a string so the whitespace inside <pre> stays exact */
const html = lines
  .map((line) =>
    line
      .map((token) => {
        const cls = CLASS_FOR[token.kind];
        const text = escape(token.t);
        return cls ? `<span class="${cls}">${text}</span>` : text;
      })
      .join(''),
  )
  .join('\n');
---

<div class:list={['code', className]}>
  <div class="code-bar">
    <i></i><i></i><i></i><span>{filename}</span>
  </div>
  <pre set:html={html} />
</div>
