---
import { site } from '../data/site';
import SectionHead from './SectionHead.astro';

const { skills, nav } = site;
const hue = nav.find((n) => n.id === 'skills')?.hue ?? 42;
---

<section class="sec" id="skills" data-hue={hue}>
  <SectionHead overline={skills.overline} lead={skills.heading.lead} dim={skills.heading.dim} />

  <p class="skills-intro rv">{skills.intro}</p>

  <div class="skill-groups">
    {
      skills.groups.map((group, i) => (
        <div class="skill-group rv" style={`transition-delay:${i * 0.08}s`}>
          <div class="sg-head">
            <span class="idx">{String(i + 1).padStart(2, '0')}</span>
            <h3>{group.label}</h3>
            <span class="count">{String(group.items.length).padStart(2, '0')}</span>
          </div>
          <div class="sg-items">
            {group.items.map((item) => (
              <span class="chip">{item}</span>
            ))}
          </div>
        </div>
      ))
    }
  </div>
</section>
