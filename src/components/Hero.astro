---
import { site } from '../data/site';

const { hero, nav } = site;
const hue = nav.find((n) => n.id === 'home')?.hue ?? 186;
---

<section class="sec hero" id="home" data-hue={hue}>
  <div class="hero-inner">
    <div class="prompt">
      <span class="sym">$</span> whoami <span class="sym">&rarr;</span> {hero.prompt}
    </div>

    <h1>
      {
        hero.lines.map((line, i) => (
          <span class={i === hero.lines.length - 1 ? 'ln accent' : 'ln'} data-t={line} />
        ))
      }
    </h1>

    <div class="fa" lang="fa" dir="rtl">{hero.nameFa}</div>

    <div class="typer">
      <span class="f">fmt</span>.<span class="fn">Println</span>(<span class="str"
        >"<b id="tw" data-roles={JSON.stringify(hero.roles)}></b></span
      ><span class="cur"></span><span class="str">"</span>)
    </div>
  </div>

  <div class="scroll-cue"><span class="bar"></span> SCROLL</div>
</section>
