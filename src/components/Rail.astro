---
import { site } from '../data/site';
---

<aside class="rail">
  <a class="logo" href="#home">
    <span class="tilde">~/</span>{site.meta.handle}<span class="caret"></span>
  </a>
  <div class="role">{site.meta.role}</div>

  <nav>
    {
      site.nav.map((item, i) => (
        <a href={`#${item.id}`} data-s={item.id}>
          <span class="fill" />
          <span class="n">{String(i + 1).padStart(2, '0')}</span>
          {item.label}
        </a>
      ))
    }
  </nav>

  <div class="rail-foot">
    <div class="pctread"><span id="pv">00</span><s>%</s></div>
    <div class="status"><span class="dot"></span> {site.meta.availability}</div>
    <button class="snd" id="snd" type="button">♪ sound: on</button>
    <div class="socials">
      {
        site.socials.map((s) => (
          <a href={s.href} title={s.title} target="_blank" rel="noopener noreferrer">
            {s.label}
          </a>
        ))
      }
    </div>
  </div>
</aside>
