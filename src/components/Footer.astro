---
import { site } from '../data/site';
---

<footer>
  <span>{site.footer.left}</span>
  {site.footer.links.length > 0 && (
  <span>
    {
      site.footer.links.map((link, i) => (
        <>
          {i > 0 && ' · '}
          <a href={link.href}>{link.label}</a>
        </>
      ))
    }
  </span>
  )}
</footer>
