---
import { site } from '../data/site';
import CodeCard from './CodeCard.astro';
import SectionHead from './SectionHead.astro';

const { about, nav } = site;
const hue = nav.find((n) => n.id === 'about')?.hue ?? 212;
---

<section class="sec" id="about" data-hue={hue}>
  <SectionHead overline={about.overline} lead={about.heading.lead} dim={about.heading.dim} />

  <div class="about-grid">
    <div class="about rv">
      {about.paragraphs.map((p) => <p set:html={p} />)}

      <div class="meta">
        {
          about.meta.map((m) => (
            <div>
              <k>{m.label}</k>
              {m.value}
            </div>
          ))
        }
      </div>

      {
        about.cv && (
          <div style="margin-top:32px">
            <a class="btn mag" href={about.cv.href} download>
              <span>{about.cv.label}</span>
            </a>
          </div>
        )
      }
    </div>

    <div class="about-side rv">
      {
        about.photo && (
          <figure class="portrait">
            {/* until the file is dropped in, remove the frame rather than
                leaving a broken image in the layout */}
            <img
              src={about.photo.src}
              alt={about.photo.alt}
              width="720"
              height="720"
              onerror="this.closest('.portrait')?.remove()"
            />
            <figcaption>{about.photo.caption}</figcaption>
          </figure>
        )
      }

      <CodeCard filename={about.codeCard.filename} lines={about.codeCard.lines} />
    </div>
  </div>
</section>
