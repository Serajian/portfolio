---
import Base from '../layouts/Base.astro';
import { site } from '../data/site';
---

{/* nginx serves this for any path that isn't a file (error_page 404) */}
<Base title={`Page not found — ${site.meta.name}`}>
  <main class="nf">
    <p class="nf-line mono"><span class="sym">$</span> curl -I {site.meta.url.replace('https://', '')}<span id="nf-path"></span></p>
    <p class="nf-line nf-status mono">HTTP/2 404</p>
    <h1 class="nf-title">Nothing lives at this address.</h1>
    <p class="nf-body">The link may be old or mistyped. Everything on this site sits on a single page.</p>
    <a class="btn" href="/">Back to the site</a>
  </main>
</Base>

<script is:inline>
  document.getElementById('nf-path').textContent = location.pathname;
</script>

<style>
  .nf {
    position: relative;
    z-index: 2;
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 16px;
    max-width: 720px;
    min-height: 100vh;
    min-height: 100svh;
    margin: 0 auto;
    padding: 64px 24px;
  }
  .mono {
    font-family: var(--mono);
  }
  .nf-line {
    font-size: 14px;
    color: var(--muted);
    overflow-wrap: anywhere;
  }
  .nf-line .sym {
    color: var(--green);
  }
  .nf-status {
    color: var(--accent);
  }
  .nf-title {
    margin: 12px 0 0;
    font-size: clamp(2.2rem, 6vw, 4rem);
    line-height: 1;
    letter-spacing: -0.04em;
  }
  .nf-body {
    max-width: 46ch;
    color: var(--text);
  }
  .nf .btn {
    align-self: flex-start;
    margin-top: 8px;
  }
</style>
